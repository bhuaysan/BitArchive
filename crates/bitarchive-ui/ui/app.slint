// BitArchive root window.
//
// This is a temporary bootstrap placeholder. It only signals that the
// application foundation runs; it is NOT the Home screen.
//
// It deliberately contains no navigation, no product screens, no design
// tokens, and no final layout (see docs/UI_UX_CONCEPT.md and ARCHITECTURE.md §40).
// Window size and colors are temporary values for development and are not a
// product minimum-size or theme decision.
//
// The placeholder labels are literal because localization is not implemented
// yet; user-facing product text belongs behind stable message IDs once the
// I18n layer exists (ARCHITECTURE.md §39).

export component AppWindow inherits Window {
    title: "BitArchive";
    width: 960px;
    height: 600px;
    background: #14141a;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            text: "BitArchive";
            font-size: 30px;
            color: #f2f2f5;
            horizontal-alignment: center;
        }

        Text {
            text: "Frontend Foundation";
            font-size: 14px;
            color: #9a9aa6;
            horizontal-alignment: center;
        }
    }
}
